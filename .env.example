# Copy to .env.local (git-ignored) and restart `npx expo start`.
# EXPO_PUBLIC_* values are bundled into the app in plain text, so NEVER put secrets here.

# Physical phone on the same Wi-Fi as the backend PC (run uvicorn with --host 0.0.0.0):
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:8000/api
# EXPO_PUBLIC_WS_BASE_URL=ws://192.168.1.10:8000

# Defaults when unset: Android emulator → http://10.0.2.2:8000/api, iOS simulator → http://localhost:8000/api
