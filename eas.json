{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://<your-railway-domain>.up.railway.app/api",
        "EXPO_PUBLIC_WS_BASE_URL": "wss://<your-railway-domain>.up.railway.app"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://<your-railway-domain>.up.railway.app/api",
        "EXPO_PUBLIC_WS_BASE_URL": "wss://<your-railway-domain>.up.railway.app"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
